<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MagoAssistant\Mago\Service\Tool\ToolRegistry">
        <arguments>
            <argument name="tools" xsi:type="array">
                <item name="rumvision" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Rumvision</item>
            </argument>
        </arguments>
        <plugin name="magoassistant_rumvision_hide_unconfigured" type="MagoAssistant\Rumvision\Plugin\HideUnconfiguredSkill"/>
    </type>

    <type name="MagoAssistant\Rumvision\Service\Skill\Rumvision">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_domains" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\ListDomains</item>
                <item name="describe_domain" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\DescribeDomain</item>
                <item name="get_metrics" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\GetMetrics</item>
                <item name="get_ux_scores" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\GetUxScores</item>
                <item name="get_ux_timeline" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\GetUxTimeline</item>
                <item name="get_health_checks" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\GetHealthChecks</item>
                <item name="get_alerts" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\GetAlerts</item>
                <item name="list_annotations" xsi:type="object">MagoAssistant\Rumvision\Service\Skill\Action\ListAnnotations</item>
            </argument>
        </arguments>
    </type>
</config>
