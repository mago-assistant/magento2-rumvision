{
    "name": "mago-assistant/magento2-rumvision",
    "description": "Mago Assistant add-on: real-user performance data (Core Web Vitals) from RUMvision",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "laminas/laminas-uri": "^2.14",
        "mago-assistant/magento2-mago": "^1.0",
        "magento/framework": "^103.0.8",
        "magento/module-config": "^101.2.8",
        "magento/module-store": "^101.1.8",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        }
    ],
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false
        }
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MagoAssistant\\Rumvision\\": ""
        }
    }
}
